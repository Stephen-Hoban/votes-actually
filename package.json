{
  "name": "votes-actually",
  "version": "1.0.0",
  "description": "Bluesky bots that post congressional vote analysis",
  "type": "module",
  "scripts": {
    "fetch-votes": "tsx src/fetchVotes.ts",
    "post-votes": "tsx src/fetchVotes.ts --post",
    "watch-votes": "tsx src/fetchVotes.ts --post --watch",
    "fetch-ages": "tsx src/fetchAgeVotes.ts",
    "post-ages": "tsx src/fetchAgeVotes.ts --post",
    "watch-ages": "tsx src/fetchAgeVotes.ts --post --watch",
    "fetch-networth": "tsx src/fetchNetWorthVotes.ts",
    "post-networth": "tsx src/fetchNetWorthVotes.ts --post",
    "watch-networth": "tsx src/fetchNetWorthVotes.ts --post --watch",
    "refresh-cache": "tsx src/refreshCache.ts",
    "refresh-members": "tsx src/refreshCache.ts -- --members",
    "refresh-census": "tsx src/refreshCache.ts -- --census",
    "refresh-ages": "tsx src/refreshCache.ts -- --ages",
    "refresh-networth": "tsx src/refreshCache.ts -- --networth",
    "migrate-supabase": "tsx src/migrateToSupabase.ts",
    "baseline-seen": "tsx src/baselineSeenVotes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@atproto/api": "^0.19.19",
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^16.0.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "ws": "^8.21.2",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@types/xml2js": "^0.4.14",
    "vitest": "^4.1.10"
  }
}
