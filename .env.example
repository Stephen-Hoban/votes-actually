# Copy to .env for local runs. In production these are GitHub Secrets
# (Settings → Secrets and variables → Actions).
#
# .env is gitignored and must stay that way — this file is the public template.

# --- Supabase: dedupe + Bluesky session storage -----------------------------
# Dashboard → Settings → API Keys. Use the SECRET key (sb_secret_...), not the
# publishable one: the tables have RLS enabled with no policies, and only the
# secret key bypasses RLS. (Supabase renamed these — "secret" is what the older
# docs call service_role, "publishable" is what they call anon.)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your-secret-key

# --- Bluesky: one account per bot persona -----------------------------------
# App passwords (not your account password): https://bsky.app/settings/app-passwords
# A leading @ on the handle is stripped automatically.
BLUESKY_POPULATION_HANDLE=population.votesactually.com
BLUESKY_POPULATION_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_AGE_HANDLE=age.votesactually.com
BLUESKY_AGE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Census: only needed to refresh reference caches ------------------------
# Not needed to run the bots — the caches are committed to the repo.
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-key

# --- Local only -------------------------------------------------------------
# Used by `npm run watch-*`. Deployment uses the GitHub Actions cron instead.
POLL_INTERVAL_MINUTES=15
